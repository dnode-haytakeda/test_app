# =============================================================================
# 環境変数の設定例
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Backend ----------
APP_ENV=development
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
BACKEND_PORT=8000

# ---------- CORS ----------
# カンマ区切りまたは JSON 配列で指定
# CORS_ORIGINS=["http://localhost:5173"]

# ---------- Frontend ----------
# VITE_API_BASE_URL=/api
